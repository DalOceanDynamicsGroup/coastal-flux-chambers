@online{gerke2026preprint,
  title = {Limits on Marine Carbon Dioxide Removal Potential Set by Coastal Air-Sea Gas Exchange Rates},
  author = {Gerke, Lennart and Ho, David and Heede, Ulla and Koffman, Tobias},
  date = {2026-02-16},
  eprinttype = {Research Square},
  issn = {2693-5015},
  doi = {10.21203/rs.3.rs-8745708/v1},
  url = {https://www.researchsquare.com/article/rs-8745708/v1},
  urldate = {2026-04-13},
  abstract = {Marine carbon dioxide removal (mCDR) has attracted significant interest as a strategy to mitigate rising atmospheric carbon dioxide (CO2) from fossil fuel burning in order to combat climate change, where a key variable is the gas transfer velocity (k), controlling air-sea CO2 fluxes. This study determined k using the 3He/SF6 dual-tracer technique in Hvalfjörður, Iceland, a potential site for mCDR research. Measured k values were lower than open ocean values at similar wind speeds, reflecting strong wind-fetch limitation in this semi-sheltered fjord. Tracer-based results indicate a short inner-fjord residence time of four days, causing rapid export of potentially perturbed surface water to the North Atlantic Ocean, where open-ocean gas exchange dominates. Consequently, local gas exchange has only a minor impact on the overall CO2 uptake estimates, provided the exported water remains in atmospheric contact. In coastal environments with substantially longer residence times and reduced k’s, or if the surface waters subduct rapidly after export, local gas exchange becomes more critical, as assuming open-ocean gas exchange would overestimate the mCDR CO2 uptake potential.},
  pubstate = {prepublished},
  file = {C\:\\Users\\Emily\\Zotero\\storage\\7GXKKQ9R\\Gerke et al. - 2026 - Limits on marine carbon dioxide removal potential set by coastal air-sea gas exchange rates.pdf;C\:\\Users\\Emily\\Zotero\\storage\\V6AHKJNW\\9087cb843281526595e4748f.pdf}
}

