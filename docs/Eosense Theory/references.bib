@article{estersParameterizingAirseaGas2017,
  title = {Parameterizing Air-Sea Gas Transfer Velocity with Dissipation},
  author = {Esters, L. and Landwehr, S. and Sutherland, G. and Bell, T. G. and Christensen, K. H. and Saltzman, E. S. and Miller, S. D. and Ward, B.},
  date = {2017},
  journaltitle = {Journal of Geophysical Research: Oceans},
  volume = {122},
  number = {4},
  pages = {3041--3056},
  issn = {2169-9291},
  doi = {10.1002/2016JC012088},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/2016JC012088},
  urldate = {2026-06-09},
  abstract = {The air-sea gas transfer velocity k is frequently estimated as an empirical function of wind speed. However, it is widely recognized that k depends on processes other than wind speed alone. The small-eddy model, which describes periodic events of small eddies disturbing the sea surface with water from below, suggests a direct relation between k and the dissipation rate of turbulent kinetic energy ϵ at the air-sea interface. This relation has been proven both in laboratories and in the field in various freshwater and coastal environments, but to date has not been verified in open ocean conditions. Here, concurrent North Atlantic field observations of ϵ and eddy covariance measurements of DMS and CO2 air-sea gas flux are presented. Using ϵ measurements, we compare the small-eddy model at various depths to previously published observations. Extrapolating the measured ϵ profiles to the thickness of the viscous sublayer allows us to formulate a function of k that depends solely on the water side friction velocity , which can be inferred from direct eddy covariance measurements of the air-side friction velocity . These field observations are generally consistent with the theoretical small-eddy model. Utilizing a variable Schmidt number exponent in the model, rather than a constant value of yields improved agreement between model and observations.},
  langid = {english},
  keywords = {air-sea gas transfer,dissipation,transfer velocity,turbulence},
  file = {C\:\\Users\\Emily\\Zotero\\storage\\W7GPIC9I\\Esters et al. - 2017 - Parameterizing air-sea gas transfer velocity with dissipation.pdf;C\:\\Users\\Emily\\Zotero\\storage\\ZWE7VZ9K\\2016JC012088.html}
}

