[Unit]
Description=Flux Chamber Data Logger Service
After=network.target

[Service]
# Run the script under your main user account so it has correct file permissions
User=dodg
WorkingDirectory=/home/dodg/Data/FluxChamber

# Force Python to flush outputs immediately so logs show up right away in journalctl
Environment=PYTHONUNBUFFERED=1

# Path to your python executable and script
ExecStart=/usr/bin/python3 /home/dodg/Data/FluxChamber/flux_logger.py

# Restart the script automatically if it fails or crashes
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
